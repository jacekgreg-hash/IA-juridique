# --- Recherche web ---
SEARXNG_URL=http://127.0.0.1:8080
BRAVE_SEARCH_API_KEY=

# --- Moteurs interchangeables (V2.14) ---
# Vision : florence (local, gratuit) | mistral (API, nécessite MISTRAL_API_KEY)
VISION_ENGINE=mistral
# OCR : paddle (service local) | mistral (API)
OCR_ENGINE=mistral
# LLM texte (extraction de modèles) : ollama | mistral
TEXT_LLM_PROVIDER=ollama

# --- API Mistral (uniquement pour les moteurs = mistral) ---
# NE JAMAIS COMMITER LE VRAI .env (voir .gitignore)
MISTRAL_API_KEY=
MISTRAL_VISION_MODEL=mistral-large-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_TEXT_MODEL=mistral-small-latest

# --- Vision (Florence-2, moteur local) ---
FLORENCE_MODEL=microsoft/Florence-2-base
FLORENCE_DEVICE=cpu
FLORENCE_DTYPE=float32
FLORENCE_NUM_BEAMS=3
# 0 = ne pas precharger Florence au demarrage de l'API
RITA_PRELOAD=1

# --- OCR (service PaddleOCR separe, Python 3.12) ---
PADDLE_OCR_URL=http://127.0.0.1:8010
PADDLE_OCR_TIMEOUT=30
# Lignes OCR sous ce score de reconnaissance : ecartees des preuves (gardees dans ocr_details.rejetes)
PADDLE_OCR_MIN_SCORE=0.50

# --- LLM texte (Ollama local) ---
OLLAMA_TEXT_URL=http://127.0.0.1:11434/api/generate
TEXT_MODEL=qwen3:0.6b
TEXT_LLM_TIMEOUT=35
TEXT_LLM_MAX_ITEMS=8

# --- Recherche externe : budget de temps (V2.14, objectif §22 du cahier des charges) ---
EXTERNAL_DEADLINE_S=20
EXTERNAL_IMAGE_WORKERS=4
EXTERNAL_MAX_IMAGES=24

# --- Limites / hygiene ---
MAX_UPLOAD_MB=15
WEB_IMAGE_CACHE_MAX_FILES=300
WEB_IMAGE_CACHE_MAX_AGE_DAYS=7
WEB_IMAGE_CACHE_PURGE_EVERY=50

RITA_IMAGE=data/reference_images/NIKE-P-6000.jpg

# --- SECURITE (obligatoire avant exposition publique) ---
# Authentification par API Key (V3.8+, §9.1 du cahier des charges)
# 0 = désactivée (développement local uniquement)
# 1 = activée (production) : toutes les requêtes nécessitent une clé API
RITA_API_AUTH_ENABLED=0
# Clé API attendue (si RITA_API_AUTH_ENABLED=1)
# Générez une clé sécurisée : openssl rand -hex 32
RITA_API_KEY=

# Rate limiting (V3.8+, §9.1 du cahier des charges)
# Nombre de requêtes par minute par IP (0 = désactivé)
RITA_RATE_LIMIT=60

# Journalisation d'accès (V3.8+, §9.1 du cahier des charges)
# 0 = désactivée (développement)
# 1 = activée : logs dans data/logs/access.log (une ligne JSON par requête)
RITA_LOG_ACCESS=0
# 0 = ne pas logger les corps de requête (RECOMMANDÉ pour RGPD)
# 1 = logger les corps de requête (désactivé par défaut)
RITA_LOG_REQUEST_BODY=0

# Chemin de la base de persistance (SQLite)
RITA_DB_PATH=data/rita.sqlite
# Chemin de la base fiscale (générée par tools/import_taric.py)
# RITA_FISCAL_DB_PATH=data/tariff/fiscal.sqlite
