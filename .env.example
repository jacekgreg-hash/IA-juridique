# --- Recherche web ---
SEARXNG_URL=http://127.0.0.1:8080
BRAVE_SEARCH_API_KEY=

# --- Vision (Florence-2) ---
FLORENCE_MODEL=microsoft/Florence-2-base
FLORENCE_DEVICE=cpu
FLORENCE_DTYPE=float32
FLORENCE_NUM_BEAMS=3
# 0 = ne pas precharger Florence au demarrage de l'API
RITA_PRELOAD=1

# --- OCR (service PaddleOCR separe, Python 3.12) ---
PADDLE_OCR_URL=http://127.0.0.1:8010
PADDLE_OCR_TIMEOUT=30
# Lignes OCR sous ce score de reconnaissance : ecartees des preuves (gardees dans ocr_details.rejetes)
PADDLE_OCR_MIN_SCORE=0.50

# --- LLM texte (extraction de modeles, uniquement si necessaire) ---
OLLAMA_TEXT_URL=http://127.0.0.1:11434/api/generate
TEXT_MODEL=qwen3:0.6b
TEXT_LLM_TIMEOUT=35

# --- Limites / hygiene ---
MAX_UPLOAD_MB=15
WEB_IMAGE_CACHE_MAX_FILES=300
WEB_IMAGE_CACHE_MAX_AGE_DAYS=7

RITA_IMAGE=data/reference_images/NIKE-P-6000.jpg
